# Exclude large/irrelevant directories from the Docker build context.
# Without this, node_modules (~500 MB) would be sent to the daemon on every build.

node_modules
.next
.git
.gitignore

# Local env files — secrets must never be baked into the image.
# NEXT_PUBLIC_* values are passed in via --build-arg instead.
.env
.env.*
*.local

# Dev-only files
docker
*.sql
*.ps1
*.md
README*

# Test output
coverage

# Playwright E2E — never needed inside the image, and e2e/.auth/ holds a live
# Supabase session cookie for the test account. .dockerignore does NOT inherit
# .gitignore, so without this line that token would be shipped into the build
# context and baked into the builder layer.
e2e
playwright.config.ts
playwright-report
test-results

# ⚠️ EXCLUDED SO THAT THE BUILDER'S OWN `RUN node scripts/copy-pdfjs-worker.mjs`
# IS THE ONLY WAY THIS FILE ENTERS THE IMAGE. It is gitignored but present in
# Adrian's working tree, so `COPY . .` was carrying a copy dated whenever he
# last ran npm install -- which silently defeats the `test -s` guard beside
# that RUN: the day pdfjs-dist v4 renames the source to `.mjs`, the script
# skips, the guard passes on the INHERITED file, and the image ships a v3
# worker against a v4 bundle ("API version does not match the Worker
# version"). Excluding it makes the guard mean what it says, and takes ~1 MB
# out of the build context.
public/pdf.worker.min.js
