# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright E2E
/e2e/.auth/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# one-time setup scripts (not part of the codebase)
supabase_migrations.sql

# local dev file uploads (paperwork pages)
/uploads/

# Adrian's machine-local Docker-stack switch scripts (Adrian <-> Ciprian UAT)
# -- not part of the codebase, never meant to be shared/committed
/local-ops/

# typescript
*.tsbuildinfo
next-env.d.ts

public/pdf.worker.min.js

# user-guide drafts kept at repo root, not part of the codebase
/UserGuide-*.docx

# Staging area for files awaiting deletion. Nothing here is part of the build:
# it is also excluded in tsconfig.json, because `include: ["**/*.ts"]` would
# otherwise type-check a parked file and fail the whole project on code that is
# on its way out.
/_to_delete/

# Intermediate reference-data dump written by build-ciprian-image.ps1 (Step 5).
# Removed on the happy path; any abort between the docker cp and that removal
# leaves it in the repo root.
/ga40prj-refdata-dump.sql

# Local diagnostic output — scripts/Check-ImportHealth.ps1
import-health.txt

# Tesseract language data, downloaded at RUNTIME into the working directory by
# tesseract.js the first time POST /api/properties/scan-image runs (measured:
# eng.traineddata 5.2 MB, ron.traineddata 3.1 MB, both landing in the repo root).
# Nothing in the repo asks for them and nothing cleans them up, so without this
# they sit untracked in every `git status` and are one `git add -A` away from an
# 8 MB commit. They are a cache: safe to delete, re-downloaded on the next scan.
#
# This surfaced in slice #32.12 because the scan-image route had had no live
# caller since AddPropertyDialog was orphaned, so it had probably never run on
# this machine. Slice #32.20 gives that dialog an entry point again, which makes
# these files a routine consequence rather than a one-off.
/*.traineddata
