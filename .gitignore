# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Playwright E2E
/e2e/.auth/
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# one-time setup scripts (not part of the codebase)
supabase_migrations.sql

# local dev file uploads (paperwork pages)
/uploads/

# Adrian's machine-local Docker-stack switch scripts (Adrian <-> Ciprian UAT)
# -- not part of the codebase, never meant to be shared/committed
/local-ops/

# typescript
*.tsbuildinfo
next-env.d.ts

public/pdf.worker.min.js

# user-guide drafts kept at repo root, not part of the codebase
/UserGuide-*.docx

# Staging area for files awaiting deletion. Nothing here is part of the build:
# it is also excluded in tsconfig.json, because `include: ["**/*.ts"]` would
# otherwise type-check a parked file and fail the whole project on code that is
# on its way out.
/_to_delete/

# Intermediate reference-data dump written by build-ciprian-image.ps1 (Step 5).
# Removed on the happy path; any abort between the docker cp and that removal
# leaves it in the repo root.
/ga40prj-refdata-dump.sql

# Scratch export of Help content, written into public/ by the admin tooling.
# In BOTH ignore files on purpose: public/ is copied wholesale into the Docker
# builder and republished by the runner, so an untracked scratch file here is
# served at /_help-entries-tmp.json in Ciprian.
/public/_help-entries-tmp.json

# Local diagnostic output — scripts/Check-ImportHealth.ps1
import-health.txt
